# Copy this file to .env.local and fill in values. .env.local is never committed.

# Anthropic API key from https://console.anthropic.com (API billing, separate from a Claude.ai subscription).
# Leave empty to run in demo mode (built-in simulated analysis, no AI).
ANTHROPIC_API_KEY=

# Maximum analyses per day across all visitors (default 200). Best-effort on Vercel: counts reset when an instance restarts.
DAILY_ANALYSIS_CAP=200

# Passcode a person types to approve an application, start level 3 auto-submit, or read the mock site's log.
# Leave empty and approval stays switched off. Set a different value in Vercel's Environment Variables.
AGENT_PASSCODE=

# Upstash Redis (added automatically when you connect Upstash in Vercel). Without them, approvals and the
# mock site's log are kept in server memory and lost on restart.
KV_REST_API_URL=
KV_REST_API_TOKEN=
